# Copy to backend/.env for LOCAL use only. Never commit the resulting file.
APP_ENV=local
LOCAL_AUTH=true
MOCK_CLAUDE=true
AWS_REGION=eu-west-1
CLAUDE_MODEL=claude-haiku-4-5-20251001
MAX_OUTPUT_TOKENS=1024
GENERATION_TIMEOUT=120
RETENTION_DAYS=30
# TODO: For real local calls set MOCK_CLAUDE=false and paste your key below, locally.
ANTHROPIC_API_KEY=
# Production receives only the following identifiers from the ECS task definition.
ANTHROPIC_SECRET_ARN=
TABLE_NAME=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
